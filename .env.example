# Copy this file to .env and fill in your own keys. Never commit .env.

# OpenAI - the roast writer (LLM). Also the voice fallback if ElevenLabs fails.
OPENAI_API_KEY=

# ElevenLabs - the roast voice and the fast-lane reaction sounds
ELEVENLABS_API_KEY=

# Deepgram - live speech-to-text (the "Start listening" mic)
DEEPGRAM_API_KEY=

# Optional: how roasts are written. self = best of 3 in one call (default), quick = one roast, best = 3 + separate judge
# ROAST_MODE=self
